{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [ "ES2022" ],

		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"strict": true,
		"isolatedModules": true,

		/*
		 * No source maps or declaration maps are emitted. They are only useful
		 * together with the TypeScript sources, and shipping those roughly
		 * triples the size of the package for every language it carries.
		 */
		"declaration": true,

		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	}
}
