{
  "name": "@ecolect/tokenization",
  "version": "0.7.0-beta.6",
  "description": "Tokenization of strings for use with graph matching in Ecolect",
  "license": "MIT",
  "repository": "https://github.com/aholstenson/ecolect-js/tree/master/packages/tokenization",
  "keywords": [
    "natural language processing",
    "nlp",
    "tokenization"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node build/unicode.js && tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "regenerate": "^1.4.2",
    "unicode-9.0.0": "^0.7.5"
  }
}
