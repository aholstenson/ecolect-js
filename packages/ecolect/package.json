{
  "name": "ecolect",
  "version": "0.7.0-beta.6",
  "description": "Natural language handling for commands and intents",
  "license": "MIT",
  "repository": "https://github.com/aholstenson/ecolect-js/tree/master/packages/ecolect",
  "keywords": [
    "natural language processing",
    "nlp",
    "intents",
    "commands",
    "parsing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./values": {
      "types": "./dist/values/index.d.ts",
      "default": "./dist/values/index.js"
    },
    "./matching": {
      "types": "./dist/matching/index.d.ts",
      "default": "./dist/matching/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ecolect/graph": "workspace:^",
    "@ecolect/language": "workspace:^",
    "@ecolect/tokenization": "workspace:^",
    "@ecolect/type-datetime": "workspace:^",
    "@ecolect/type-numbers": "workspace:^",
    "datetime-types": "^0.3.0",
    "fast-equals": "^6.0.3",
    "numeric-types": "^0.3.1",
    "rfdc": "^1.4.1"
  },
  "devDependencies": {
    "@ecolect/language-en": "workspace:^"
  }
}
