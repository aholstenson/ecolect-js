{
	"extends": "./tsconfig.settings.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": [ "src", "test" ],
	"exclude": [ "**/node_modules/**", "**/dist/**" ],

	"typedocOptions": {
		"name": "Ecolect",
		"entryPoints": [
			"src/index.ts",
			"src/matching/index.ts",
			"src/values/index.ts",

			"src/graph/index.ts",
			"src/language/index.ts",
			"src/language/loader.ts",
			"src/language/en/index.ts",
			"src/tokenization/index.ts",
			"src/type-datetime/index.ts",
			"src/type-numbers/index.ts"
		],
		"out": "apidocs",
		"excludePrivate": true
	}
}
