{
	"extends": "./tsconfig.settings.json",
	"compilerOptions": {
		"noEmit": true,

		"paths": {
			"ecolect": [ "./packages/ecolect/src/index.ts" ],
			"@ecolect/language-*": [ "./languages/*/src/index.ts" ],
			"@ecolect/*": [ "./packages/*/src/index.ts" ]
		}
	},
	"include": [ "packages/*/src", "languages/*/src" ],
	"exclude": [ "**/node_modules/**", "**/dist/**" ],
	"typedocOptions": {
		"name": "Ecolect",
		"entryPoints": [
			"packages/ecolect/src/index.ts",

			"packages/graph/src/index.ts",
			"packages/language/src/index.ts",
			"packages/tokenization/src/index.ts",
			"packages/type-datetime/src/index.ts",
			"packages/type-numbers/src/index.ts"
		],
		"out": "apidocs",
		"excludePrivate": true
	}
}
